# Dòng 1: Chọn image nền là Nginx bản nhẹ
                    FROM nginx:alpine

                    # Dòng 2: Sao chép file index.html từ máy tính (host) vào trong container
                    COPY index.html /usr/share/nginx/html/index.html

                    # Dòng 3: Khai báo container sẽ dùng cổng 80 (chỉ để thông tin)
                    EXPOSE 80
